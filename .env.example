# Copy to .env and adjust. Real environment variables always win over this file.

# --- Core -------------------------------------------------------------------
# Never run production with DEBUG on.
DJANGO_DEBUG=False
# Required when DEBUG is off. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Optional: encrypts the password copy admins can reveal on the worker list.
# Falls back to DJANGO_SECRET_KEY. Changing it makes stored copies unreadable until
# each worker logs in again or gets a new password. Generate like the secret key.
PASSWORD_REVEAL_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full origins (scheme + host) allowed to POST forms, e.g. https://ombor.example.uz
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Asia/Tashkent

# --- Database ---------------------------------------------------------------
# PostgreSQL is the production database. Without DATABASE_URL a local SQLite
# file (db.sqlite3) is used, which is fine for a quick look but has no
# database-level append-only trigger on the ledger.
DATABASE_URL=postgres://wms:change-me@localhost:5432/wms
DB_CONN_MAX_AGE=60

# --- HTTPS / proxy (only read when DEBUG is off) --------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
# Secure-only session/CSRF cookies. Set False only when the site is served over plain
# HTTP (no TLS at all), otherwise login cannot work.
DJANGO_SECURE_COOKIES=True
# Set to True when running behind nginx/Caddy/a load balancer that terminates TLS
# and sends X-Forwarded-Proto.
DJANGO_BEHIND_PROXY=False
# Start small (e.g. 3600) and raise to 31536000 once HTTPS is confirmed everywhere.
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_HSTS_PRELOAD=False

# --- Application ------------------------------------------------------------
WMS_BRAND_NAME=Mebel Ombori
# Self-registration attempts per client IP (API endpoint).
REGISTRATION_THROTTLE_RATE=10/hour
DJANGO_LOG_LEVEL=INFO

# --- docker compose only ------------------------------------------------------
# Password for the bundled postgres:16 container (docker-compose.yml).
POSTGRES_PASSWORD=
